
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && request.auth.uid == 'oiNKNvX9sQbdgjhxMP71eSiGkkH2';
    }

    // Default deny all for security
    match /{document=**} {
      allow read, write: if false;
    }

    // Students: Publicly readable by ID for the portal, write protected
    match /students/{studentId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    match /teachers/{teacherId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    match /classes/{classId}/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    match /income/{incomeId} {
       allow read: if true;
       allow write: if isAuthenticated();
    }
    
    match /expenses/{expenseId} {
       allow read, write: if isAuthenticated();
    }
    
    match /reports/{reportId} {
        allow read, write: if isAuthenticated();
    }
    
    match /teacher_payouts/{payoutId} {
        allow read, write: if isAuthenticated();
    }
    
    match /academy_share/{payoutId} {
        allow read, write: if isAuthenticated();
    }
    
    match /exams/{examId} {
      allow read: if true;
      allow write: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }
    
    match /attendance/{attendanceId} {
       allow read: if true;
       allow write: if isAuthenticated();
    }
    
    match /teacher_attendance/{attendanceId} {
      allow list, read, write: if isAuthenticated();
    }
    
    match /settings/{settingId} {
       allow read: if true;
       allow write: if isAuthenticated();
    }
    
    match /message_logs/{logId} {
        // Allow creation from anyone (including server actions and teacher actions)
        allow create: if true;
        allow read: if isAuthenticated();
    }
    
    match /system_state/{stateId} {
       allow read, write: if isAuthenticated();
    }
    
    match /activities/{activityId} {
       // Allow teachers and admin to record activity logs
       allow read, write: if isAuthenticated();
    }
    
    match /discounts/{discountId} {
       allow read, write: if isAuthenticated();
    }
    
    match /notifications/{notificationId} {
      allow read, update: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated();
    }
    
    // Super Admin bypass for all collections
    match /{collection}/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
