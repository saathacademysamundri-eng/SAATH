
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Default deny all for security
    match /{document=**} {
      allow read, write: if false;
    }

    // Rules for specific collections
    match /students/{studentId} {
      allow read, write: if isAuthenticated();
    }
    match /teachers/{teacherId} {
      allow read, write: if isAuthenticated();
    }
    match /classes/{classId}/{document=**} {
      allow read, write: if isAuthenticated();
    }
    match /income/{incomeId} {
       allow read, write: if isAuthenticated();
    }
    match /expenses/{expenseId} {
       allow read, write: if isAuthenticated();
    }
    match /reports/{reportId} {
        allow read, write: if isAuthenticated();
    }
    match /teacher_payouts/{payoutId} {
        allow read, write: if isAuthenticated();
    }
    match /academy_share/{payoutId} {
        allow read, write: if isAuthenticated();
    }
    match /exams/{document=**} {
      // Allow any authenticated user to read/list exams, and write them.
      // Client-side code will filter to show teachers only their assigned exams.
      allow read, write: if isAuthenticated();
    }
    match /attendance/{attendanceId} {
       allow read, write: if isAuthenticated();
    }
    match /teacher_attendance/{document=**} {
      // Allow any authenticated user to read/list teacher attendance.
      // Client-side code will filter for the specific teacher.
       allow read, write: if isAuthenticated();
    }
    match /settings/{settingId} {
       allow read, write: if isAuthenticated();
    }
    match /message_logs/{logId} {
        allow create: if isAuthenticated();
        allow read, update, delete: if false;
    }
    match /system_state/{stateId} {
       allow read, write: if isAuthenticated();
    }
    match /activities/{activityId} {
       allow read, write: if isAuthenticated();
    }
  }
}
