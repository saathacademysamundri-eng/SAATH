rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && request.auth.uid == 'oiNKNvX9sQbdgjhxMP71eSiGkkH2';
    }

    // Default deny all for security
    match /{document=**} {
      allow read, write: if false;
    }

    // Students
    match /students/{studentId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    // Teachers
    match /teachers/{teacherId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    // Classes
    match /classes/{classId}/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    // Income
    match /income/{incomeId} {
       allow read: if true;
       allow write: if isAuthenticated();
    }
    
    // Expenses
    match /expenses/{expenseId} {
       allow read, write: if isAuthenticated();
    }
    
    // Reports & Payouts
    match /reports/{reportId} {
        allow read, write: if isAuthenticated();
    }
    match /teacher_payouts/{payoutId} {
        allow read, write: if isAuthenticated();
    }
    match /academy_share/{payoutId} {
        allow read, write: if isAuthenticated();
    }
    
    // Exams - Explicit permissions for teachers to save results
    match /exams/{examId} {
      allow read: if true;
      allow create, update, delete, write: if isAuthenticated();
    }
    
    // Attendance
    match /attendance/{attendanceId} {
       allow read: if true;
       allow write, create, update: if isAuthenticated();
    }
    match /teacher_attendance/{attendanceId} {
      allow list, read, write, create, update: if isAuthenticated();
    }
    
    // Configuration & State
    match /settings/{settingId} {
       allow read: if true;
       allow write: if isAuthenticated();
    }
    match /system_state/{stateId} {
       allow read, write: if isAuthenticated();
    }
    
    // Logs, Activities & Notifications
    match /message_logs/{logId} {
        allow create, write: if true;
        allow read: if isAuthenticated();
    }
    match /activities/{activityId} {
       allow read, write, create: if isAuthenticated();
    }
    match /notifications/{notificationId} {
      allow read, update: if isAuthenticated() && request.auth.uid == resource.data.userId;
      allow create: if isAuthenticated();
    }
    
    // Discounts
    match /discounts/{discountId} {
       allow read, write: if isAuthenticated();
    }
    
    // Super Admin bypass for all collections (recursive)
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}